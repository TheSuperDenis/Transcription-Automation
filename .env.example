# Host port. The launcher finds another local port if this one is occupied.
TRANSCRIBER_PORT=43127

# Good default for English speech. Other examples: tiny.en, small.en, medium.en,
# large-v3, turbo. Larger models need more memory and take longer to download.
WHISPER_MODEL=small.en

# Maximum accepted upload size in bytes (2 GiB by default).
MAX_UPLOAD_BYTES=2147483648

# Reproducible container build inputs.
PYTHON_IMAGE=python:3.11.16-slim-bookworm
TORCH_VERSION=2.11.0
